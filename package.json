{
  "name": "fncts",
  "packageManager": "pnpm@11.2.2",
  "type": "module",
  "license": "BSD 3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/0x706b/fncts"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "release": "pnpm publish -r --provenance",
    "build": "tsc -b --verbose",
    "build-pack": "pnpm build && pnpm -r --parallel --if-present run build-pack",
    "format": "pnpm -r --parallel --if-present run format",
    "clean": "pnpm -r --parallel --if-present run clean && pnpm run postclean",
    "test": "pnpm vitest",
    "build-lint-deps": "pnpm --filter @fncts/scripts run build-pack && pnpm --filter @fncts/codegen... run build-pack",
    "align-package-lint-format": "node ./scripts/align-package-lint-format.mjs",
    "lint": "pnpm -r --parallel --if-present run lint",
    "circular": "pnpm -r --parallel --if-present run circular",
    "postclean": "pnpm -r --if-present run postclean",
    "postinstall": "tsplus-install",
    "org:eslint": "cd $INIT_CWD && eslint",
    "org:prettier": "cd $INIT_CWD && prettier",
    "org:tsc": "cd $INIT_CWD && tsc",
    "org:babel": "cd $INIT_CWD && babel",
    "org:rolldown": "cd $INIT_CWD && rolldown",
    "org:concurrently": "cd $INIT_CWD && concurrently",
    "org:madge": "cd $INIT_CWD && madge",
    "org:vitest": "cd $INIT_CWD && vitest",
    "org:prettier-eslint": "cd $INIT_CWD && prettier-eslint",
    "org:dpdm": "cd $INIT_CWD && dpdm"
  },
  "devDependencies": {
    "@0x706b/eslint-plugin-align-assignments": "^0.1.2",
    "@0x706b/eslint-plugin-module-specifier-extensions": "^0.2.0",
    "@0x706b/tsplus-installer": "^0.0.190",
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "10.0.1",
    "@fncts/base": "workspace:*",
    "@fncts/cache": "workspace:*",
    "@fncts/codegen": "workspace:*",
    "@fncts/config": "workspace:*",
    "@fncts/eslint-config": "workspace:*",
    "@fncts/express": "workspace:*",
    "@fncts/http": "workspace:*",
    "@fncts/io": "workspace:*",
    "@fncts/node": "workspace:*",
    "@fncts/observable": "workspace:*",
    "@fncts/pattern": "workspace:*",
    "@fncts/query": "workspace:*",
    "@fncts/react": "workspace:*",
    "@fncts/schema": "workspace:*",
    "@fncts/scripts": "workspace:*",
    "@fncts/test": "workspace:*",
    "@fncts/transformers": "workspace:*",
    "@fncts/typelevel": "workspace:*",
    "@rollup/pluginutils": "^5.5.1",
    "@types/benchmark": "^2.1.5",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/experimental-utils": "^5.62.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-c8": "^0.33.0",
    "benchmark": "^2.1.4",
    "concurrently": "^10.0.6",
    "dpdm": "^4.3.0",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.10",
    "rolldown": "1.2.15",
    "tinybench": "^6.2.2",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "resolutions": {}
}
