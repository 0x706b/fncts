{
  "name": "@fncts/base",
  "version": "0.0.43",
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "./build/dts/*"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "exports": {
    "./*": {
      "types": "./build/dts/*.d.ts",
      "import": "./build/esm/*.js",
      "require": "./build/cjs/*.cjs"
    },
    ".": {
      "types": "./build/dts/index.d.ts",
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.cjs"
    }
  },
  "scripts": {
    "build": "pnpm -w run org:tsc -b ./tsconfig.json",
    "build-js": "pnpm -w run org:rolldown -c ./rolldown.config.js",
    "build-pack": "pnpm build && pnpm build-js && fncts-pack",
    "test": "pnpm -w run org:tsc -b ./tsconfig.test.json && pnpm -w run org:vitest",
    "format": "pnpm -w run org:prettier --list-different -w src/**/*.ts",
    "lint": "pnpm -w run org:eslint src/**/*.ts",
    "circular": "pnpm -w run org:dpdm --exit-code circular:1 --circular --tsconfig ./tsconfig.build.json ./src/**/* -T",
    "clean": "rm -rf ./build ./dist"
  },
  "dependencies": {
    "@fncts/typelevel": "workspace:*",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@fncts/config": "workspace:*",
    "@fncts/eslint-config": "workspace:*",
    "@fncts/scripts": "workspace:*",
    "@types/node": "^25.2.2",
    "@types/uuid": "^10.0.0"
  }
}
