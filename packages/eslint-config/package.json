{
  "name": "@fncts/eslint-config",
  "version": "0.0.29",
  "repository": {
    "type": "git",
    "url": "https://github.com/0x706b/fncts"
  },
  "type": "module",
  "scripts": {
    "build": "rm -rf build && mkdir build && mkdir build/mjs && cp eslint.config.js build/mjs/index.mjs && cp legacyPlugin.js build/mjs/legacyPlugin.mjs",
    "build-pack": "pnpm build && fncts-pack mjs",
    "postclean": "pnpm build-pack"
  },
  "dependencies": {
    "@0x706b/eslint-plugin-align-assignments": "^0.1.2",
    "@0x706b/eslint-plugin-module-specifier-extensions": "^0.2.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "10.0.1",
    "@fncts/codegen": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/experimental-utils": "^5.62.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "typescript-eslint": "^8.72.0"
  },
  "peerDependencies": {
    "eslint": "^9.6.0"
  },
  "devDependencies": {
    "@fncts/config": "workspace:*",
    "@fncts/scripts": "workspace:*",
    "@types/eslint__js": "^9.14.0"
  },
  "exports": {
    ".": {
      "import": "./eslint.config.js"
    },
    "./*": {
      "import": "./*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
