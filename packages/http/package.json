{
  "name": "@fncts/http",
  "version": "0.0.12",
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "./build/dts/*"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "exports": {
    "./*": {
      "types": "./build/dts/*.d.ts",
      "import": "./build/esm/*.js",
      "require": "./build/cjs/*.cjs"
    },
    ".": {
      "types": "./build/dts/index.d.ts",
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.cjs"
    }
  },
  "scripts": {
    "build": "yarn org:tsc -b ./tsconfig.json",
    "build-mjs": "yarn org:babel build/esm --config-file ./.babel.mjs.json --out-dir build/mjs --out-file-extension .mjs --source-maps",
    "build-cjs": "yarn org:babel build/esm --config-file ./.babel.cjs.json --out-dir build/cjs --out-file-extension .cjs --source-maps",
    "build-pack": "yarn build && yarn org:concurrently \"yarn build-cjs\" \"yarn build-mjs\" && fncts-pack",
    "test": "yarn org:tsc -b ./tsconfig.test.json && yarn org:vitest",
    "lint": "yarn org:eslint src/**/*.ts",
    "format": "yarn org:prettier --list-different -w src/**/*.ts",
    "circular": "yarn org:dpdm --exit-code circular:1 --circular --tsconfig ./tsconfig.build.json ./src/**/* -T",
    "clean": "rm -rf ./build ./dist"
  },
  "dependencies": {
    "@fncts/base": "workspace:*",
    "@fncts/io": "workspace:*",
    "@fncts/schema": "workspace:*",
    "@fncts/typelevel": "workspace:*",
    "find-my-way": "^9.3.0",
    "find-my-way-ts": "^0.1.5",
    "isows": "^1.0.7",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@fncts/config": "workspace:*",
    "@fncts/eslint-config": "workspace:*",
    "@fncts/scripts": "workspace:*",
    "@types/react": "^18.3.23",
    "@types/uuid": "^10.0.0"
  }
}
