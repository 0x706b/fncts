{
  "name": "@fncts/node",
  "version": "0.0.45",
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/_mjs/*.mjs",
      "require": "./dist/_cjs/*.cjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/_mjs/index.mjs",
      "require": "./dist/_cjs/index.cjs"
    }
  },
  "scripts": {
    "build": "pnpm -w run org:tsc -b ./tsconfig.json",
    "build-js": "pnpm -w run org:rolldown -c ./rolldown.config.js",
    "build-pack": "pnpm build && pnpm build-js && fncts-pack",
    "test": "pnpm -w run org:tsc -b ./tsconfig.test.json && pnpm -w run org:vitest",
    "lint": "pnpm -w run org:eslint \"{src,test}/**/*.ts\"",
    "format": "pnpm -w run org:prettier --list-different -w \"{src,test}/**/*.ts\"",
    "circular": "pnpm -w run org:dpdm --exit-code circular:1 --circular --tsconfig ./tsconfig.build.json ./src/**/* -T",
    "clean": "rm -rf ./build ./dist"
  },
  "dependencies": {
    "@fncts/io": "workspace:*",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@fncts/config": "workspace:*",
    "@fncts/eslint-config": "workspace:*",
    "@fncts/scripts": "workspace:*",
    "@types/ws": "^8.18.1"
  }
}
