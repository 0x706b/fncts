{
  "name": "@fncts/scripts",
  "private": true,
  "version": "0.0.29",
  "repository": {
    "type": "git",
    "url": "https://github.com/0x706b/fncts"
  },
  "type": "module",
  "bin": {
    "fncts-pack": "./bin/fncts-pack.js",
    "fncts-transform": "./bin/fncts-transform.js"
  },
  "exports": {
    "./*": "./build/esm/*.js",
    "./*.js": "./build/esm/*.js"
  },
  "scripts": {
    "build": "pnpm -w run org:tsc -b ./tsconfig.json",
    "build-pack": "pnpm build",
    "lint": "pnpm -w run org:eslint src/**/*.ts",
    "format": "pnpm -w run org:prettier --list-different -w src/**/*.ts",
    "circular": "pnpm -w run org:dpdm --exit-code circular:1 --circular --tsconfig ./tsconfig.build.json ./src/**/* -T",
    "clean": "rm -rf ./build",
    "postclean": "pnpm build-pack"
  },
  "devDependencies": {
    "@babel/plugin-syntax-class-properties": "^7.12.13",
    "@babel/plugin-syntax-typescript": "^7.27.1",
    "@babel/types": "^7.27.3",
    "@types/babel__core": "^7.20.5",
    "@fncts/eslint-config": "workspace:*",
    "recast": "^0.23.11"
  }
}
