{
  "name": "@fncts/codegen",
  "version": "0.0.25",
  "type": "module",
  "scripts": {
    "build": "yarn org:tsc -b && yarn build-cjs",
    "build-mjs": "yarn org:babel build/esm --config-file ./.babel.mjs.json --out-dir build/mjs --out-file-extension .mjs --source-maps",
    "build-cjs": "yarn org:babel build/esm --config-file ./.babel.cjs.json --out-dir build/cjs --out-file-extension .cjs --source-maps",
    "build-pack": "yarn build && yarn org:concurrently \"yarn build-cjs\" \"yarn build-mjs\" && fncts-pack",
    "postclean": "yarn build-pack",
    "clean": "rm -rf ./build",
    "lint": "yarn org:eslint src/**/*.ts",
    "format": "yarn org:prettier --list-different -w src/**/*.ts"
  },
  "exports": {
    "./*": {
      "import": "./build/esm/*.js",
      "require": "./build/cjs/*.cjs",
      "types": "./build/dts/*.d.ts"
    },
    ".": {
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.cjs",
      "types": "./build/dts/index.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./build/dts/*"
      ]
    }
  },
  "devDependencies": {
    "@0x706b/eslint-plugin-align-assignments": "^0.1.2",
    "@babel/generator": "^7.27.3",
    "@babel/parser": "^7.27.4",
    "@fncts/scripts": "workspace:*",
    "@types/babel__generator": "^7.27.0",
    "@types/benchmark": "^2.1.5",
    "@types/glob": "^8.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.17",
    "@types/prettier": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/experimental-utils": "^5.62.0",
    "@typescript-eslint/parser": "^8.57.2",
    "benchmark": "^2.1.4",
    "eslint": "^10.2.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.5.3"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "io-ts-extra": "^0.11.6",
    "js-yaml": "^4.1.1",
    "lodash": "^4.17.21"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
