{
  "name": "@fncts/codegen",
  "version": "0.0.27",
  "type": "module",
  "scripts": {
    "build": "pnpm -w run org:tsc -b",
    "build-js": "pnpm -w run org:rolldown -c ./rolldown.config.js",
    "build-pack": "pnpm build && pnpm build-js && fncts-pack",
    "postclean": "pnpm build-pack",
    "clean": "rm -rf ./build",
    "lint": "pnpm -w run org:eslint src/**/*.ts",
    "format": "pnpm -w run org:prettier --list-different -w src/**/*.ts"
  },
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/_mjs/*.mjs",
      "require": "./dist/_cjs/*.cjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/_mjs/index.mjs",
      "require": "./dist/_cjs/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "devDependencies": {
    "@babel/generator": "^7.27.3",
    "@babel/parser": "^7.27.4",
    "@fncts/eslint-config": "workspace:*",
    "@fncts/config": "workspace:*",
    "@fncts/scripts": "workspace:*",
    "@types/babel__generator": "^7.27.0",
    "@types/glob": "^8.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.17",
    "prettier": "^3.5.3"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "io-ts-extra": "^0.11.6",
    "js-yaml": "^4.1.1",
    "lodash": "^4.17.21",
    "ts-pattern": "^5.9.0"
  },
  "peerDependencies": {
    "@babel/generator": "^7.27.3",
    "@babel/parser": "^7.27.4"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
