{
  "name": "@fncts/codegen",
  "version": "0.0.26",
  "type": "module",
  "scripts": {
    "build": "yarn org:tsc -b",
    "build-js": "yarn org:rolldown -c ./rolldown.config.js",
    "build-pack": "yarn build && yarn build-js && fncts-pack",
    "postclean": "yarn build-pack",
    "clean": "rm -rf ./build",
    "lint": "yarn org:eslint src/**/*.ts",
    "format": "yarn org:prettier --list-different -w src/**/*.ts"
  },
  "exports": {
    "./*": {
      "types": "./build/dts/*.d.ts",
      "import": "./build/esm/*.js",
      "require": "./build/cjs/*.cjs"
    },
    ".": {
      "types": "./build/dts/index.d.ts",
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./build/dts/*"
      ]
    }
  },
  "devDependencies": {
    "@babel/generator": "^7.27.3",
    "@babel/parser": "^7.27.4",
    "@fncts/scripts": "workspace:*",
    "@types/babel__generator": "^7.27.0",
    "@types/glob": "^8.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.17",
    "prettier": "^3.5.3"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "io-ts-extra": "^0.11.6",
    "js-yaml": "^4.1.1",
    "lodash": "^4.17.21"
  },
  "peerDependencies": {
    "@babel/generator": "^7.27.3",
    "@babel/parser": "^7.27.4"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
